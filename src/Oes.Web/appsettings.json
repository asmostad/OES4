{
  "ConnectionStrings": {
    "Oes": "Server=localhost;Port=3306;Database=oes4;User=oes4;Password=set-via-env-or-user-secrets"
  },
  "App": {
    "BaseUrl": "https://oes.example.com"
  },
  "FileStore": {
    "RootPath": "D:\\OES4Data\\files",
    "MaxBytes": 52428800
  },
  "SystemMail": {
    "Provider": "Ses",
    "FromAddress": "no-reply@example.com",
    "FromName": "Pich",
    "SesRegion": "us-east-2"
  },
  "DataProtection": {
    "KeysPath": "D:\\OES4Data\\keys"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "D:\\OES4Data\\logs\\web-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ]
  },
  "AllowedHosts": "*"
}
