@page
@model Oes.Web.Pages.Admin.NurtureModel
@using Oes.Domain.Communication
@{
    ViewData["Title"] = "Nurture Workflows";
}
<div class="page-header">
    <div>
        <h1>Nurture Workflows</h1>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item">Administration</li><li class="breadcrumb-item active">Nurture Workflows</li></ol></nav>
    </div>
</div>
<div class="row g-3">
    <div class="col-xl-8">
        <div class="card">
            @if (Model.Rows.Count == 0)
            {
                <div class="empty-state"><i class="bi bi-arrow-repeat"></i><h5>No workflows yet</h5><p>For example: follow up on an estimate after 2, 5 and 10 days, then hand the rep a call task.</p></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-clickable mb-0 align-middle">
                        <thead><tr><th>Workflow</th><th>Kind</th><th class="text-end">Steps</th><th class="text-end">In it now</th><th class="text-end">Finished</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var s in Model.Rows)
                            {
                                <tr data-href="/Admin/NurtureEdit?id=@s.Id" class="@(s.IsActive ? "" : "text-muted")">
                                    <td><a class="fw-medium" href="/Admin/NurtureEdit?id=@s.Id">@s.Name</a></td>
                                    <td>@(s.Category == MessagePurposes.Marketing ? "Marketing" : "Everyday")</td>
                                    <td class="text-end">@s.Steps</td><td class="text-end">@s.Active</td><td class="text-end">@s.Completed</td>
                                    <td>@if (!s.IsActive) { <span class="badge bg-secondary-subtle text-secondary">Off</span> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header">New workflow</div>
            <div class="card-body">
                <form method="post" class="row g-2">
                    <div class="col-12"><input name="input.Name" class="form-control form-control-sm" required maxlength="150" placeholder="Estimate follow-up" aria-label="Name"></div>
                    <div class="col-12"><select name="input.Category" class="form-select form-select-sm" aria-label="Kind">
                        <option value="@MessagePurposes.Transactional">Everyday (about their job)</option>
                        <option value="@MessagePurposes.Marketing">Marketing</option></select>
                        <div class="form-text">Marketing emails get your mailing address and an unsubscribe link, and texts need a marketing opt-in.</div></div>
                    <div class="col-12"><button class="btn btn-sm btn-primary" type="submit">Create</button></div>
                </form>
            </div>
        </div>
    </div>
</div>
