@page
@model Oes.Web.Pages.Admin.RolesModel
@{
    ViewData["Title"] = "Roles & Permissions";
}
<div class="page-header">
    <div>
        <h1>Roles &amp; Permissions</h1>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item">Administration</li><li class="breadcrumb-item active">Roles</li></ol></nav>
    </div>
    <a class="btn btn-primary btn-sm" href="/Admin/RoleEdit"><i class="bi bi-plus-lg me-1"></i> New role</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-clickable mb-0 align-middle">
            <thead><tr><th>Role</th><th>Description</th><th class="text-center">Permissions</th><th class="text-center">Users</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model.Roles)
                {
                    <tr>
                        <td class="fw-medium"><a href="/Admin/RoleEdit?id=@r.Id">@r.Name</a>
                            @if (r.IsSystem) { <span class="badge bg-secondary-subtle text-secondary ms-1">Built-in</span> }</td>
                        <td class="text-muted">@r.Description</td>
                        <td class="text-center">@r.PermissionCount of @Permissions.All.Count</td>
                        <td class="text-center">@r.MemberCount</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/Admin/RoleEdit?id=@r.Id"><i class="bi bi-pencil"></i> Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
