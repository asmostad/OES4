@page
@model Oes.Web.Pages.Admin.BookingTypesModel
@{
    ViewData["Title"] = "Online Booking";
    var publicUrl = Model.PublicUrl;
}
<div class="page-header">
    <div>
        <h1>Online Booking</h1>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item">Administration</li><li class="breadcrumb-item active">Online Booking</li></ol></nav>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" href="/Availability"><i class="bi bi-clock me-1"></i> Weekly hours</a>
        <a class="btn btn-primary btn-sm" href="/Admin/BookingTypeEdit"><i class="bi bi-plus-lg me-1"></i> New booking type</a>
    </div>
</div>
<div class="card mb-3">
    <div class="card-body d-flex flex-wrap align-items-center gap-2">
        <div class="me-auto"><div class="small text-muted">Your booking page</div>
            <a href="@publicUrl" target="_blank" rel="noopener" class="fw-medium">@publicUrl</a></div>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-copy="@publicUrl">Copy link</button>
    </div>
    <div class="card-footer small text-muted">Put it on your website and in your email signature. Open times come from each host's weekly hours, minus anything already on their calendar.</div>
</div>
<div class="card">
    @if (Model.Types.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-calendar-plus"></i><h5>Nothing bookable yet</h5><p>Add a booking type, like "Free roof inspection", and pick who takes them.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-clickable mb-0 align-middle">
                <thead><tr><th>Booking type</th><th>Length</th><th>Hosts</th><th></th></tr></thead>
                <tbody>
                    @foreach (var t in Model.Types)
                    {
                        <tr data-href="/Admin/BookingTypeEdit?id=@t.Id" class="@(t.IsActive ? "" : "text-muted")">
                            <td><a class="fw-medium" href="/Admin/BookingTypeEdit?id=@t.Id">@t.Name</a><div class="small text-muted">/book/@Model.CompanySlug/@t.Slug</div></td>
                            <td>@t.DurationMinutes min</td>
                            <td>@t.Hosts.Count</td>
                            <td>@if (!t.IsActive) { <span class="badge bg-secondary-subtle text-secondary">Off</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
