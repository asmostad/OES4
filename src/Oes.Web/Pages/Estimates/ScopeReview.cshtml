@page "{id:guid}"
@model Oes.Web.Pages.Estimates.ScopeReviewModel
@using Oes.Domain.Estimating
@{
    var v = Model.View;
    var i = v.Import;
    var e = v.Estimate;
    var us = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    string M(decimal? x) => x is null ? "—" : x.Value.ToString("C2", us);
    var signed = e.Status == EstimateStatuses.Signed;
    var open = i.Status == ScopeImportStatuses.Review && !signed;
    var matched = v.Lines.Count(l => l.PriceListItemId is not null);
    ViewData["Title"] = $"Carrier scope · {e.Number}";
}
<div class="page-header">
    <div>
        <h1>Carrier scope <span class="text-muted fs-5">· @i.FileName</span></h1>
        <nav aria-label="breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Estimates/View/@e.Id">@e.Number @e.Name</a></li>
            <li class="breadcrumb-item"><a href="/Estimates/ImportScope/@e.Id">Import carrier scope</a></li>
            <li class="breadcrumb-item active">Review</li>
        </ol></nav>
    </div>
</div>

<div class="alert @(open ? "alert-warning" : "alert-secondary") small">
    <i class="bi bi-stars me-1"></i><strong>Read by AI@(i.Carrier is null ? "" : " · " + i.Carrier)@(i.CarrierPriceList is null ? "" : " · price list " + i.CarrierPriceList).</strong>
    @if (open)
    {
        <text>Check each line against the scope before adding. @matched of @v.Lines.Count lines matched your price list and use your price; the rest come in as custom lines at the carrier's price and need approval.</text>
    }
    else
    {
        <text>@(i.Status == ScopeImportStatuses.Imported ? "This scope was added to the estimate." : i.Status == ScopeImportStatuses.Discarded ? "This scope was discarded." : "The estimate is signed, so these lines can't be added to it. Use the supplement compare.")</text>
    }
    @if (i.Notes is not null) { <div class="mt-1 pre-wrap">@i.Notes</div> }
</div>

<div class="mb-3"><a class="btn btn-sm btn-outline-secondary" href="/Estimates/Supplement/@i.Id"><i class="bi bi-arrow-left-right me-1"></i>Compare with our estimate (supplement)</a></div>

<form method="post">
    @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert alert-danger"></div> }
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-sm mb-0 align-middle">
                <thead><tr>
                    <th scope="col"><span class="visually-hidden">Add</span></th><th>Code</th><th>Description</th><th class="text-end">Qty</th><th>Unit</th>
                    <th class="text-end">Carrier price</th><th>Your price list</th><th class="text-end">Your price</th>
                </tr></thead>
                <tbody>
                    @foreach (var l in v.Lines)
                    {
                        var diff = l.OurUnitPrice is { } ours && l.CarrierUnitPrice is { } theirs && ours != theirs;
                        <tr>
                            <td><input type="checkbox" class="form-check-input" name="Include" value="@l.Index" checked="@open" disabled="@(!open)" aria-label="Add line @(l.Index + 1)"></td>
                            <td class="text-nowrap small">@l.Category @l.Code<div class="text-muted">@(l.Activity.Length == 0 ? "" : Fmt.Cap(l.Activity.Replace('_', ' ')))</div></td>
                            <td>@l.Description</td>
                            <td class="text-end" style="width:7rem"><input type="number" step="any" min="0" name="Quantity[@l.Index]" value="@l.Quantity.ToString("0.##")" class="form-control form-control-sm text-end" disabled="@(!open)" aria-label="Quantity line @(l.Index + 1)"></td>
                            <td class="small">@l.Unit</td>
                            <td class="text-end">@M(l.CarrierUnitPrice)</td>
                            <td class="small">@if (l.MatchedDescription is null) { <span class="badge text-bg-light border">Custom line</span> } else { @l.MatchedDescription }</td>
                            <td class="text-end @(diff ? "fw-semibold" : "")">@M(l.OurUnitPrice)</td>
                        </tr>
                    }
                    @if (v.Lines.Count == 0) { <tr><td colspan="8" class="text-muted">The AI found no line items in this scope.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
    @if (open)
    {
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <input name="SectionName" class="form-control" style="max-width:320px" maxlength="150" placeholder="Section name (default: Carrier scope)" aria-label="Section name">
            <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add ticked lines to the estimate</button>
            <button type="submit" asp-page-handler="Discard" class="btn btn-outline-danger" formnovalidate>Discard</button>
        </div>
    }
</form>
