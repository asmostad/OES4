@page
@model Oes.Web.Pages.WorkOrders.IndexModel
@using Oes.Domain.Subcontractors
@{
    ViewData["Title"] = "Work Orders";
}
<div class="page-header">
    <div>
        <h1>Work Orders</h1>
        <p class="page-subtitle">Create work orders from a project's trade. Issuing one sends the sub a private link to accept and report completion.</p>
    </div>
</div>
<form method="get" class="card mb-3"><div class="card-body d-flex gap-2 align-items-center">
    <select name="status" class="form-select form-select-sm w-auto" data-autosubmit aria-label="Status"><option value="">Any status</option>
        @foreach (var s in WorkOrderStatuses.All) { <option value="@s" selected="@(Model.Status == s)">@Fmt.Cap(s)</option> }</select>
</div></form>
<div class="card"><partial name="_WorkOrderTable" model="Model.Rows" /></div>
