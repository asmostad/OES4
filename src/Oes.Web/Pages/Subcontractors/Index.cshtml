@page
@model Oes.Web.Pages.Subcontractors.IndexModel
@inject Shell ShellService
@{
    ViewData["Title"] = "Subcontractors";
    var shell = await ShellService.GetAsync();
}
<div class="page-header">
    <div>
        <h1>Subcontractors</h1>
        <p class="page-subtitle">Crews you send work orders to. Each sub is an organization contact with documents, rates and a portal link per work order.</p>
    </div>
    @if (shell?.Can(Permissions.SubcontractorsManage) == true) { <a class="btn btn-primary btn-sm" href="/Subcontractors/New"><i class="bi bi-plus-lg me-1"></i> Subcontractor</a> }
</div>

<form method="get" class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <div class="input-group input-group-sm list-search"><span class="input-group-text"><i class="bi bi-search"></i></span>
            <input name="q" value="@Model.Q" class="form-control" placeholder="Company name"></div>
        <select name="trade" class="form-select form-select-sm w-auto" data-autosubmit aria-label="Trade"><option value="">All trades</option>
            @foreach (var t in Model.Trades) { <option value="@t.Code" selected="@(Model.Trade == t.Code)">@t.Name</option> }</select>
        <div class="form-check mb-0"><input class="form-check-input" type="checkbox" name="all" value="true" id="all" checked="@Model.All" data-autosubmit-check><label class="form-check-label small" for="all">Include inactive</label></div>
        <button class="btn btn-sm btn-secondary" type="submit">Search</button>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-clickable mb-0 align-middle">
            <thead><tr><th>Company</th><th>Trades</th><th>Phone</th><th>Email</th><th>Insurance</th><th class="text-center">Open WOs</th></tr></thead>
            <tbody>
                @if (Model.Rows.Count == 0) { <tr><td colspan="6"><div class="empty-state py-3"><i class="bi bi-people-fill"></i><h5>No subcontractors</h5></div></td></tr> }
                @foreach (var s in Model.Rows)
                {
                    <tr data-href="/Subcontractors/View/@s.Id">
                        <td class="fw-medium"><i class="bi bi-building text-level-organization me-1"></i><a href="/Subcontractors/View/@s.Id">@s.Name</a>
                            @if (s.Status != "active") { <span class="badge bg-secondary-subtle text-secondary ms-1">@Fmt.Cap(s.Status)</span> }</td>
                        <td class="small">@string.Join(", ", s.TradeNames)</td>
                        <td class="text-nowrap">@s.Phone</td>
                        <td>@s.Email</td>
                        <td><partial name="_InsuranceBadge" model="(s.InsuranceExpiresOn, s.InsuranceDaysLeft)" /></td>
                        <td class="text-center">@(s.OpenWorkOrders > 0 ? s.OpenWorkOrders.ToString() : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
