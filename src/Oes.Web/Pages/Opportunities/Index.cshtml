@page
@model Oes.Web.Pages.Opportunities.IndexModel
@using Oes.Domain.Crm
@{
    ViewData["Title"] = "Opportunities";
    var isBoard = Model.View != "list";
    string Toggle(string view) => $"?view={view}&q={Uri.EscapeDataString(Model.Q ?? "")}&mine={Model.Mine.ToString().ToLowerInvariant()}&storm={Model.StormId}";
}
<div class="page-header">
    <div>
        <h1>Opportunities</h1>
        <p class="page-subtitle">Every lead is an opportunity. Drag cards between stages on the board.</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        @await Component.InvokeAsync("SavedViews", new { listKey = "opportunities" })
        <a class="btn btn-primary btn-sm" href="/Opportunities/New"><i class="bi bi-plus-lg me-1"></i> New lead</a>
    </div>
</div>

<form method="get" class="card mb-3">
    <input type="hidden" name="view" value="@Model.View">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <div class="btn-group btn-group-sm me-2" role="group" aria-label="View">
            <a class="btn @(isBoard ? "btn-secondary" : "btn-outline-secondary")" href="@Toggle("board")"><i class="bi bi-kanban me-1"></i>Board</a>
            <a class="btn @(!isBoard ? "btn-secondary" : "btn-outline-secondary")" href="@Toggle("list")"><i class="bi bi-list-ul me-1"></i>List</a>
        </div>
        <div class="input-group input-group-sm list-search">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input name="q" value="@Model.Q" class="form-control" placeholder="Number, name, contact or address">
        </div>
        @if (!isBoard)
        {
            <select name="stage" class="form-select form-select-sm w-auto" data-autosubmit>
                <option value="">Any stage</option>
                @foreach (var s in Model.Stages) { <option value="@s.Id" selected="@(Model.Stage == s.Id)">@s.Name</option> }
            </select>
            <select name="outcome" class="form-select form-select-sm w-auto" data-autosubmit>
                <option value="">Any outcome</option>
                @foreach (var o in new[] { Outcomes.Open, Outcomes.Won, Outcomes.Lost }) { <option value="@o" selected="@(Model.Outcome == o)">@Fmt.Cap(o)</option> }
            </select>
        }
        @if (Model.Storms.Count > 0)
        {
            <select name="storm" class="form-select form-select-sm w-auto" data-autosubmit aria-label="Storm">
                <option value="">Any storm</option>
                @foreach (var s in Model.Storms) { <option value="@s.Id" selected="@(Model.StormId == s.Id)">@s.Name</option> }
            </select>
        }
        <div class="form-check mb-0 ms-1">
            <input class="form-check-input" type="checkbox" name="mine" value="true" id="mine" checked="@Model.Mine" data-autosubmit-check>
            <label class="form-check-label small" for="mine">Only mine</label>
        </div>
        <button class="btn btn-sm btn-secondary" type="submit">Search</button>
    </div>
</form>

@if (isBoard)
{
    <div class="pipeline-board" data-board data-move-url="/api/v1/opportunities/{id}/stage" data-lost-reasons='@System.Text.Json.JsonSerializer.Serialize(Model.LostReasons.Select(r => new { r.Value, r.Label }))'>
        @foreach (var col in Model.Board)
        {
            <section class="pipeline-column" data-stage-id="@col.Stage.Id" data-outcome="@col.Stage.Outcome" style="--stage-color:@col.Stage.Color">
                <header class="pipeline-column-header">
                    <span class="stage-dot"></span>@col.Stage.Name
                    <span class="pipeline-count">@col.Cards.Count</span>
                </header>
                <div class="pipeline-cards" data-dropzone>
                    @foreach (var o in col.Cards)
                    {
                        <article class="pipeline-card @(o.IsStale ? "stale" : "")" draggable="true" data-card-id="@o.Id">
                            <a href="/Opportunities/View/@o.Id" class="pipeline-card-title">@o.Name</a>
                            <div class="pipeline-card-meta"><i class="bi bi-person"></i> @o.ContactName</div>
                            @if (o.Address is not null) { <div class="pipeline-card-meta"><i class="bi bi-house-door"></i> @o.Address</div> }
                            else { <div class="pipeline-card-meta text-warning"><i class="bi bi-house-exclamation"></i> No address yet</div> }
                            <div class="pipeline-card-foot">
                                <code>@o.Number</code>
                                @if (o.IsInsurance) { <span class="badge bg-info-subtle text-info" title="Insurance"><i class="bi bi-shield-check"></i></span> }
                                @if (o.IsStale) { <span class="badge bg-warning-subtle text-warning" title="No stage change for a while"><i class="bi bi-hourglass-split"></i> Stale</span> }
                                <span class="ms-auto">@(o.ExpectedValue is null ? "" : Fmt.Money(o.ExpectedValue))</span>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-clickable mb-0 align-middle">
                <thead><tr><th>Number</th><th>Opportunity</th><th>Contact</th><th>Stage</th><th>Owner</th><th class="text-end">Value</th><th>Created</th></tr></thead>
                <tbody>
                    @if (Model.List.Items.Count == 0)
                    {
                        <tr><td colspan="7"><div class="empty-state"><i class="bi bi-funnel"></i><h5>No opportunities found</h5></div></td></tr>
                    }
                    @foreach (var o in Model.List.Items)
                    {
                        <tr data-href="/Opportunities/View/@o.Id">
                            <td><code class="small">@o.Number</code></td>
                            <td><a href="/Opportunities/View/@o.Id" class="fw-medium">@o.Name</a>
                                <div class="small text-muted">@(o.Address ?? "No address yet")</div></td>
                            <td>@o.ContactName</td>
                            <td><span class="stage-pill" style="--stage-color:@o.StageColor">@o.StageName</span></td>
                            <td class="text-muted">@(o.OwnerName ?? "Unassigned")</td>
                            <td class="text-end">@Fmt.Money(o.ExpectedValue)</td>
                            <td class="text-muted small text-nowrap">@o.CreatedAt.ToString("MMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Pager" model="(Model.List.Page, Model.List.Pages, Model.List.Total)" />
}
