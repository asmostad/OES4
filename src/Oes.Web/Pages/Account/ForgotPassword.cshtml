@page
@model Oes.Web.Pages.Account.ForgotPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
    ViewData["Tagline"] = "Reset your password";
}
<h4>Forgot password</h4>
@if (Model.Sent)
{
    <p class="subtitle">If that email belongs to an account, a reset link is on its way. Check your inbox.</p>
    <a class="btn btn-login" href="/Account/Login"><i class="bi bi-arrow-left me-1"></i> Back to sign in</a>
}
else
{
    <p class="subtitle">Enter your email and we'll send you a reset link.</p>
    <form method="post">
        <div class="mb-4">
            <label asp-for="Email" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input asp-for="Email" class="form-control" placeholder="you@company.com" autofocus>
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-login"><i class="bi bi-send me-1"></i> Send reset link</button>
    </form>
    <div class="text-center mt-3"><a class="forgot-link" href="/Account/Login">Back to sign in</a></div>
}
