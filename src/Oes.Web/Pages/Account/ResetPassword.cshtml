@page
@model Oes.Web.Pages.Account.ResetPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset password";
    ViewData["Tagline"] = "Choose a new password";
}
<h4>Reset password</h4>
@if (Model.Done)
{
    <p class="subtitle">Your password has been changed.</p>
    <a class="btn btn-login" href="/Account/Login"><i class="bi bi-box-arrow-in-right me-1"></i> Sign in</a>
}
else
{
    <p class="subtitle">Use at least 12 characters.</p>
    @foreach (var e in Model.Errors)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i>@e</div>
    }
    <form method="post">
        <input type="hidden" asp-for="UserId">
        <input type="hidden" asp-for="Code">
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password">
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-login"><i class="bi bi-check-lg me-1"></i> Save new password</button>
    </form>
}
