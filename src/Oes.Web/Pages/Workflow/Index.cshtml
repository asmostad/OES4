@page
@model Oes.Web.Pages.Workflow.IndexModel
@{
    ViewData["Title"] = "Workflow Board";
    var us = System.Globalization.CultureInfo.GetCultureInfo("en-US");
}
<div class="page-header">
    <div>
        <h1>Workflow Board</h1>
        <p class="page-subtitle">Every trade in production. Drag a card to move it: dates are checked first, and the project advances on its own when its trades do.</p>
    </div>
</div>

<form method="get" class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <select name="trade" class="form-select form-select-sm w-auto" data-autosubmit aria-label="Trade">
            <option value="">All trades</option>
            @foreach (var t in Model.Trades) { <option value="@t.Id" selected="@(Model.Trade == t.Id)">@t.Name</option> }
        </select>
        <div class="form-check mb-0"><input class="form-check-input" type="checkbox" name="mine" value="true" id="mine" checked="@Model.Mine" data-autosubmit-check><label class="form-check-label small" for="mine">Only my projects</label></div>
    </div>
</form>

<div class="pipeline-board" data-board data-move-url="/api/v1/trades/{id}/stage" data-reload-on-auto>
    @foreach (var col in Model.Board)
    {
        <section class="pipeline-column" data-stage-id="@col.Stage.Id" style="--stage-color:@col.Stage.Color">
            <header class="pipeline-column-header"><span class="stage-dot"></span>@col.Stage.Name<span class="pipeline-count">@col.Cards.Count</span></header>
            <div class="pipeline-cards" data-dropzone>
                @foreach (var c in col.Cards)
                {
                    <article class="pipeline-card trade-card @(c.IsStale ? "stale" : "")" draggable="true" data-card-id="@c.Id" style="--trade-color:@c.TradeColor">
                        <a href="/Projects/Trade/@c.Id" class="pipeline-card-title"><i class="bi @c.TradeIcon me-1"></i>@c.TradeName</a>
                        <div class="pipeline-card-meta"><code>@c.ProjectNumber</code> @c.ProjectName</div>
                        <div class="pipeline-card-meta"><i class="bi bi-house-door"></i> @(c.Address ?? "no address")</div>
                        <div class="pipeline-card-foot">
                            <span title="Material delivery"><i class="bi bi-truck"></i> @(c.MaterialDate?.ToString("MMM d") ?? "—")</span>
                            <span title="Work date"><i class="bi bi-calendar-event"></i> @(c.WorkDate?.ToString("MMM d") ?? "—")</span>
                            @if (c.IsStale) { <span class="badge bg-warning-subtle text-warning"><i class="bi bi-hourglass-split"></i></span> }
                            <span class="ms-auto">@c.Amount.ToString("C0", us)</span>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>
