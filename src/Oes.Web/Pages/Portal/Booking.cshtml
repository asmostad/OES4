@page "/portal/b/{token}"
@model Oes.Web.Pages.Portal.BookingModel
@{
    Layout = "_PortalLayout";
    var v = Model.View;
    ViewData["Title"] = v is null ? "Link not available" : $"Your appointment with {v.Company}";
}
@if (v is null)
{
    <div class="portal-card text-center">
        <i class="bi bi-link-45deg fs-1 text-muted"></i>
        <h1 class="h4 mt-2">This link isn't available</h1>
        <p class="text-muted mb-0">It may have expired. Please call the company to change your appointment.</p>
    </div>
}
else
{
    <div class="portal-card">
        @if (v.Cancelled)
        {
            <div class="text-center"><i class="bi bi-calendar-x fs-1 text-muted"></i><h1 class="h4 mt-2">Appointment cancelled</h1>
                <p class="text-muted mb-0">Your @v.TypeName with @v.Company on @v.StartsLocal.ToString("dddd, MMMM d") is cancelled.</p></div>
        }
        else
        {
            <div class="text-center mb-3">
                <i class="bi bi-calendar-check fs-1 text-success"></i>
                <h1 class="h4 mt-2">@(Model.Booked ? "You're booked!" : Model.Moved ? "Your appointment was moved" : "Your appointment")</h1>
            </div>
            <dl class="row mb-3">
                <dt class="col-4">What</dt><dd class="col-8">@v.TypeName (@v.DurationMinutes min)</dd>
                <dt class="col-4">When</dt><dd class="col-8">@v.StartsLocal.ToString("dddd, MMMM d 'at' h:mm tt")</dd>
                @if (v.Address is not null) { <dt class="col-4">Where</dt><dd class="col-8">@v.Address</dd> }
                <dt class="col-4">With</dt><dd class="col-8">@v.HostName, @v.Company</dd>
            </dl>
            @if (Model.Booked || Model.Moved) { <p class="small text-muted">We've emailed you these details and this link. Keep it to change or cancel if plans change.</p> }
            @if (Model.Error is not null) { <div class="alert alert-danger small py-2">@Model.Error</div> }
            @if (Model.Reschedule && v.CanReschedule)
            {
                var basePath = $"/portal/b/{Model.Token}?reschedule=true";
                @if (Model.Date is { } d && Model.Time is { } t && Model.Slots.TryGetValue(d, out var times) && times.Contains(t))
                {
                    <form method="post" asp-page-handler="Reschedule" class="alert alert-light border d-flex flex-wrap align-items-center gap-2">
                        <input type="hidden" name="date" value="@d.ToString("yyyy-MM-dd")"><input type="hidden" name="time" value="@t.ToString("HH:mm")">
                        <div>Move it to <strong>@d.ToString("dddd, MMMM d")</strong> at <strong>@t.ToString("h:mm tt")</strong>?</div>
                        <div class="ms-auto d-flex gap-2"><a class="btn btn-sm btn-link" href="@basePath">Pick another</a><button class="btn btn-sm btn-primary" type="submit">Move it</button></div>
                    </form>
                }
                else
                {
                    <h2 class="h6">Pick a new time</h2>
                    @if (Model.Slots.Count == 0) { <p class="small text-muted">There are no other open times right now. Please call us.</p> }
                    @foreach (var (day, list) in Model.Slots)
                    {
                        <div class="book-day">
                            <div class="fw-medium mb-1">@day.ToString("dddd, MMMM d")</div>
                            <div class="book-times">
                                @foreach (var slot in list) { <a class="btn btn-sm btn-outline-primary" href="@basePath&amp;date=@day.ToString("yyyy-MM-dd")&amp;time=@slot.ToString("HH:mm")">@slot.ToString("h:mm tt")</a> }
                            </div>
                        </div>
                    }
                    <div class="text-center"><a class="small" href="/portal/b/@Model.Token">Keep my current time</a></div>
                }
            }
            else if (!v.Past)
            {
                <div class="d-flex justify-content-center gap-2">
                    @if (v.CanReschedule) { <a class="btn btn-outline-primary btn-sm" href="/portal/b/@Model.Token?reschedule=true">Change time</a> }
                    <form method="post" asp-page-handler="Cancel">
                        <button class="btn btn-outline-danger btn-sm" type="submit" data-confirm="Cancel this appointment?">Cancel appointment</button>
                    </form>
                </div>
            }
        }
    </div>
}
