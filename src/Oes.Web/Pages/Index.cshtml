@page
@model Oes.Web.Pages.IndexModel
@inject Shell ShellService
@{
    ViewData["Title"] = "Dashboard";
    var shell = await ShellService.GetAsync();
    var c = Model.Counts;
}
<div class="page-header">
    <div>
        <h1>Dashboard</h1>
        <p class="page-subtitle">Welcome back, @(shell?.FullName). You're working in <strong>@(shell?.TenantName)</strong>.</p>
    </div>
    <a class="btn btn-primary btn-sm" href="/Opportunities/New"><i class="bi bi-plus-lg me-1"></i> New lead</a>
</div>

<div class="row g-3">
    @foreach (var (label, value, icon, color, href) in new[]
    {
        ("Open opportunities", c.Open.ToString("N0"), "bi-funnel", "primary", "/Opportunities?view=list&outcome=open"),
        ("Open pipeline value", Fmt.Money(c.OpenValue), "bi-currency-dollar", "success", "/Opportunities"),
        ("Leads with no address", c.NeedAddress.ToString("N0"), "bi-house-exclamation", "warning", "/Opportunities?view=list&outcome=open"),
        ("Stale in their stage", c.Stale.ToString("N0"), "bi-hourglass-split", "danger", "/Opportunities"),
    })
    {
        <div class="col-sm-6 col-xl-3">
            <a class="card stat-card text-decoration-none" href="@href">
                <div class="d-flex align-items-center">
                    <div class="stat-icon bg-@color-subtle text-@color"><i class="bi @icon"></i></div>
                    <div class="ms-3">
                        <div class="stat-value">@value</div>
                        <div class="stat-label">@label</div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<div class="row g-3 mt-1">
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header d-flex align-items-center"><i class="bi bi-funnel text-level-opportunity me-2"></i>My open opportunities
                <a class="btn btn-sm btn-link ms-auto" href="/Opportunities?mine=true">Board</a></div>
            @if (Model.Recent.Count == 0)
            {
                <div class="card-body text-muted small">Nothing open assigned to you. <a href="/Opportunities/New">Add a lead</a>.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-clickable mb-0 align-middle">
                        <tbody>
                            @foreach (var o in Model.Recent)
                            {
                                <tr data-href="/Opportunities/View/@o.Id">
                                    <td><a href="/Opportunities/View/@o.Id" class="fw-medium">@o.Name</a>
                                        <div class="small text-muted">@o.ContactName · @(o.Address ?? "no address yet")</div></td>
                                    <td class="text-nowrap"><span class="stage-pill" style="--stage-color:@o.StageColor">@o.StageName</span>
                                        @if (o.IsStale) { <span class="badge bg-warning-subtle text-warning ms-1"><i class="bi bi-hourglass-split"></i></span> }</td>
                                    <td class="text-end text-nowrap">@Fmt.Money(o.ExpectedValue)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center"><i class="bi bi-sun text-warning me-2"></i>My day
                <a class="btn btn-sm btn-link ms-auto" href="/Calendar">Calendar</a></div>
            <div class="card-body pb-2">
                <div class="d-flex gap-3 mb-2">
                    <a href="/Tasks" class="text-decoration-none"><span class="stat-value fs-4 @(Model.Day.Overdue > 0 ? "text-danger" : "")">@Model.Day.Overdue</span> <span class="small text-muted">overdue</span></a>
                    <a href="/Tasks" class="text-decoration-none"><span class="stat-value fs-4">@Model.Day.DueToday</span> <span class="small text-muted">due today</span></a>
                </div>
            </div>
            <ul class="list-group list-group-flush small">
                @if (Model.Day.Appointments.Count == 0) { <li class="list-group-item text-muted">No appointments today.</li> }
                @foreach (var a in Model.Day.Appointments)
                {
                    <li class="list-group-item @(a.Status != "scheduled" ? "text-muted" : "")">
                        <span class="fw-medium">@(a.IsAllDay ? "All day" : a.StartLocal.ToString("h:mm tt"))</span> ·
                        @if (a.RecordUrl is not null) { <a href="@a.RecordUrl">@a.Title</a> } else { @a.Title }
                        @if (a.Location is not null) { <div class="text-muted">@a.Location</div> }
                    </li>
                }
            </ul>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2"><i class="bi bi-trophy text-success fs-4 me-2"></i><div class="stat-value fs-3">@c.WonThisMonth</div></div>
                <div class="text-muted small">Won this month</div>
            </div>
        </div>
    </div>
</div>
