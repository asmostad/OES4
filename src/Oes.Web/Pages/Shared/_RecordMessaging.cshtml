@* Email and text compose for a record. Merge fields are filled in on send. *@
@model Oes.Web.ViewComponents.ComposeModel
@{
    var self = Context.Request.Path + Context.Request.QueryString;
    var key = Model.EntityId.ToString("N")[..8];
    var emailFirst = Model.CanEmail;
}
<div class="card mb-3 record-messaging">
    <div class="card-header d-flex align-items-center"><i class="bi bi-chat-left-text me-2"></i>Message
        <ul class="nav nav-pills nav-sm ms-auto" role="tablist">
            @if (Model.CanEmail) { <li class="nav-item"><button class="nav-link py-0 px-2 @(emailFirst ? "active" : "")" type="button" data-bs-toggle="tab" data-bs-target="#msg-email-@key" role="tab">Email</button></li> }
            @if (Model.CanSms) { <li class="nav-item"><button class="nav-link py-0 px-2 @(!emailFirst ? "active" : "")" type="button" data-bs-toggle="tab" data-bs-target="#msg-sms-@key" role="tab">Text</button></li> }
        </ul>
    </div>
    <div class="card-body tab-content">
        @if (Model.CanEmail)
        {
            <div class="tab-pane fade @(emailFirst ? "show active" : "")" id="msg-email-@key" role="tabpanel">
                @if (Model.Emails.Count == 0)
                {
                    <div class="text-muted small">No email address on file for this record's contacts.</div>
                }
                else
                {
                    <form method="post" asp-antiforgery="true" action="/Messages/Send?handler=Email" class="row g-2" data-template-form>
                        <input type="hidden" name="email.EntityType" value="@Model.EntityType"><input type="hidden" name="email.EntityId" value="@Model.EntityId">
                        <input type="hidden" name="email.ContactId" value="@Model.Emails[0].ContactId" data-contact-id><input type="hidden" name="returnUrl" value="@self">
                        <div class="col-12"><select name="email.To" class="form-select form-select-sm" aria-label="To" data-recipient>
                            @foreach (var r in Model.Emails) { <option value="@r.Address" data-contact="@r.ContactId">@r.ContactName &lt;@r.Display&gt;</option> }</select></div>
                        @if (Model.EmailTemplates.Count > 0)
                        {
                            <div class="col-12"><select class="form-select form-select-sm" name="email.TemplateId" aria-label="Template" data-template-picker>
                                <option value="">No template</option>
                                @foreach (var t in Model.EmailTemplates) { <option value="@t.Id" data-subject="@t.Subject" data-body="@t.Body">@t.Name</option> }</select></div>
                        }
                        <div class="col-6"><input name="email.Cc" class="form-control form-control-sm" placeholder="CC (optional)" maxlength="2000" aria-label="CC"></div>
                        <div class="col-6"><input name="email.Bcc" class="form-control form-control-sm" placeholder="BCC (optional)" maxlength="2000" aria-label="BCC"></div>
                        <div class="col-12"><input name="email.Subject" class="form-control form-control-sm" placeholder="Subject" required maxlength="300" aria-label="Subject" data-template-subject></div>
                        <div class="col-12"><textarea name="email.Body" class="form-control form-control-sm" rows="5" placeholder="Message" required maxlength="100000" aria-label="Message" data-template-body></textarea></div>
                        @if (Model.Files.Count > 0)
                        {
                            <div class="col-12"><details class="small" data-attach-files>
                                <summary class="text-muted"><i class="bi bi-paperclip"></i> Attach files from this record (up to 10, 20 MB in all)</summary>
                                <div class="mt-1" style="max-height:12rem;overflow-y:auto">
                                    @foreach (var f in Model.Files)
                                    {
                                        <div class="form-check"><input class="form-check-input" type="checkbox" name="email.DocumentIds" value="@f.Id" id="att-@key-@(f.Id.ToString("N")[..8])">
                                            <label class="form-check-label" for="att-@key-@(f.Id.ToString("N")[..8])">@f.FileName <span class="text-muted">· @Fmt.Size(f.SizeBytes)@(f.CategoryKey is null ? "" : " · " + Fmt.Cap(f.CategoryKey))</span></label></div>
                                    }
                                </div>
                            </details></div>
                        }
                        <div class="col-12 d-flex align-items-center"><span class="form-text mt-0">Sent from your mailbox. {{merge.fields}} are filled in.</span>
                            <button class="btn btn-sm btn-primary ms-auto" type="submit"><i class="bi bi-send me-1"></i>Send</button></div>
                    </form>
                }
            </div>
        }
        @if (Model.CanSms)
        {
            <div class="tab-pane fade @(!emailFirst ? "show active" : "")" id="msg-sms-@key" role="tabpanel">
                @if (!Model.TextingReady)
                {
                    <div class="text-muted small">Texting isn't set up. An administrator adds the company's texting number under Texting &amp; SMS Templates.</div>
                }
                else if (Model.Phones.Count == 0)
                {
                    <div class="text-muted small">No phone number on file for this record's contacts.</div>
                }
                else
                {
                    var firstOk = Model.Phones.FirstOrDefault(p => p.Blocked is null);
                    <form method="post" asp-antiforgery="true" action="/Messages/Send?handler=Sms" class="row g-2" data-template-form>
                        <input type="hidden" name="sms.EntityType" value="@Model.EntityType"><input type="hidden" name="sms.EntityId" value="@Model.EntityId">
                        <input type="hidden" name="sms.ContactId" value="@((firstOk.To ?? Model.Phones[0].To).ContactId)" data-contact-id><input type="hidden" name="returnUrl" value="@self">
                        <div class="col-12"><select name="sms.To" class="form-select form-select-sm" aria-label="To" data-recipient>
                            @foreach (var (r, blocked) in Model.Phones)
                            {
                                <option value="@r.Address" data-contact="@r.ContactId" disabled="@(blocked is not null)" selected="@(r == firstOk.To)">@r.ContactName · @r.Display @(blocked is null ? "" : $"— {blocked}")</option>
                            }</select></div>
                        @if (Model.Phones.All(p => p.Blocked is not null))
                        {
                            <div class="col-12 small text-danger">No one here can be texted right now. The reason is shown next to each number.</div>
                        }
                        else
                        {
                            @if (Model.SmsTemplates.Count > 0)
                            {
                                <div class="col-12"><select class="form-select form-select-sm" name="sms.TemplateId" aria-label="Template" data-template-picker>
                                    <option value="">No template</option>
                                    @foreach (var t in Model.SmsTemplates) { <option value="@t.Id" data-body="@t.Body">@t.Name</option> }</select></div>
                            }
                            <div class="col-12"><textarea name="sms.Body" class="form-control form-control-sm" rows="3" placeholder="Text message" required maxlength="1500" aria-label="Text message" data-template-body data-char-count></textarea></div>
                            <div class="col-12 d-flex align-items-center"><span class="form-text mt-0">From the company number.</span>
                                <button class="btn btn-sm btn-primary ms-auto" type="submit"><i class="bi bi-send me-1"></i>Send text</button></div>
                        }
                    </form>
                }
            </div>
        }
    </div>
</div>
