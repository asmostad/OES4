@model List<Oes.Infrastructure.Estimating.EstimateRow>
@using Oes.Domain.Estimating
<div class="table-responsive">
    <table class="table table-clickable mb-0 align-middle">
        <thead><tr><th>Number</th><th>Estimate</th><th>Customer</th><th>Method</th><th>Status</th><th class="text-end">Total</th><th>Updated</th></tr></thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7"><div class="empty-state py-3"><i class="bi bi-calculator"></i><h5>No estimates</h5><p>Open an opportunity and choose <strong>New estimate</strong>.</p></div></td></tr>
            }
            @foreach (var e in Model)
            {
                <tr data-href="/Estimates/View/@e.Id">
                    <td><code class="small">@e.Number</code></td>
                    <td><a href="/Estimates/View/@e.Id" class="fw-medium">@e.Name</a><div class="small text-muted">@(e.Address ?? "no address")</div></td>
                    <td>@e.ContactName</td>
                    <td class="small">@(e.Method == EstimateMethods.PriceBook ? "Price book" : "Line items")</td>
                    <td><span class="est-status est-@e.Status">@Fmt.Cap(e.Status)@(e.LatestVersionNo > 0 ? $" · v{e.LatestVersionNo}" : "")</span>
                        @if (e.PendingApprovals > 0) { <span class="badge bg-warning-subtle text-warning ms-1" title="Price exceptions waiting"><i class="bi bi-hourglass-split"></i> @e.PendingApprovals</span> }</td>
                    <td class="text-end fw-medium">@e.Total.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
                    <td class="small text-muted text-nowrap">@Fmt.Ago(e.UpdatedAt)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
