@model (int Page, int Pages, int Total)
@{
    string Link(int p)
    {
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Context.Request.QueryString.Value)
            .ToDictionary(kv => kv.Key, kv => (string?)kv.Value.ToString());
        q["p"] = p.ToString();
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path, q);
    }
}
<div class="d-flex justify-content-between align-items-center mt-3 small text-muted">
    <span>@Model.Total.ToString("N0") result@(Model.Total == 1 ? "" : "s")</span>
    @if (Model.Pages > 1)
    {
        <nav aria-label="Pages">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page - 1)">&lsaquo;</a></li>
                <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.Pages</span></li>
                <li class="page-item @(Model.Page >= Model.Pages ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page + 1)">&rsaquo;</a></li>
            </ul>
        </nav>
    }
</div>
