@page
@model Oes.Web.Pages.Storms.IndexModel
@inject Shell ShellService
@{
    ViewData["Title"] = "Storm Events";
    var shell = await ShellService.GetAsync();
}
<div class="page-header">
    <div>
        <h1>Storm Events</h1>
        <p class="page-subtitle">Group leads, claims and canvassing by storm. Tag a lead with its storm on the lead form.</p>
    </div>
    @if (shell?.Can(Permissions.StormsManage) == true)
    {
        <a class="btn btn-primary btn-sm" href="/Storms/Edit"><i class="bi bi-plus-lg me-1"></i> Storm</a>
    }
</div>

@if (Model.Storms.Count == 0)
{
    <div class="card"><div class="empty-state"><i class="bi bi-cloud-lightning-rain"></i><h5>No storms yet</h5>
        <p>Add a storm (date, hail size, ZIP codes) to group the leads and claims it brings in.</p></div></div>
}
<div class="row g-3">
    @foreach (var s in Model.Storms)
    {
        <div class="col-md-6 col-xl-4">
            <a class="card storm-card text-decoration-none h-100" href="/Storms/View/@s.Id">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-3">
                        <div class="record-icon level-storm"><i class="bi bi-cloud-lightning-rain"></i></div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-body">@s.Name</div>
                            <div class="small text-muted">@s.EventDate.ToString("ddd, MMM d, yyyy") · @Fmt.Cap(s.PerilKey)
                                @(s.MaxHailSizeIn is null ? "" : $" · {s.MaxHailSizeIn:0.##}\" hail")@(s.MaxWindMph is null ? "" : $" · {s.MaxWindMph} mph")</div>
                        </div>
                    </div>
                    <div class="storm-stats">
                        <div><strong>@s.Opportunities</strong><span>leads</span></div>
                        <div><strong>@s.Claims</strong><span>claims</span></div>
                        <div><strong>@Fmt.Money(s.PipelineValue)</strong><span>pipeline</span></div>
                        <div><strong>@s.ZipCount</strong><span>ZIPs</span></div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
