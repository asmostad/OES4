@model (Guid? Id, Oes.Infrastructure.Insurance.SupplementInput Input)
@using Oes.Domain.Insurance
@{
    var s = Model.Input;
    var key = Model.Id?.ToString("N") ?? "new";
}
<form method="post" asp-page-handler="Supplement" class="row g-2 align-items-end">
    @if (Model.Id is not null) { <input type="hidden" name="supplementId" value="@Model.Id"> }
    <div class="col-md-4">
        <label class="form-label small" for="r-@key">For</label>
        <input id="r-@key" name="supplement.Reason" value="@s.Reason" class="form-control form-control-sm" maxlength="500" required placeholder="Drip edge, O&amp;P, code upgrade…">
    </div>
    <div class="col-md-2">
        <label class="form-label small" for="s-@key">Status</label>
        <select id="s-@key" name="supplement.Status" class="form-select form-select-sm">
            @foreach (var st in SupplementStatuses.All) { <option value="@st" selected="@(s.Status == st)">@Fmt.Cap(st)</option> }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small" for="q-@key">Requested $</label>
        <input id="q-@key" type="number" min="0" step="0.01" name="supplement.RequestedAmount" value="@s.RequestedAmount" class="form-control form-control-sm">
    </div>
    <div class="col-md-2">
        <label class="form-label small" for="a-@key">Approved $</label>
        <input id="a-@key" type="number" min="0" step="0.01" name="supplement.ApprovedAmount" value="@s.ApprovedAmount" class="form-control form-control-sm">
    </div>
    <div class="col-md-2"><button class="btn btn-sm btn-primary w-100" type="submit">@(Model.Id is null ? "Add" : "Save")</button></div>
    @if (Model.Id is not null)
    {
        <div class="col-md-3"><label class="form-label small" for="so-@key">Sent on</label><input id="so-@key" type="date" name="supplement.SentOn" value="@s.SentOn?.ToString("yyyy-MM-dd")" class="form-control form-control-sm"></div>
        <div class="col-md-3"><label class="form-label small" for="ro-@key">Answered on</label><input id="ro-@key" type="date" name="supplement.RespondedOn" value="@s.RespondedOn?.ToString("yyyy-MM-dd")" class="form-control form-control-sm"></div>
        <div class="col-md-6"><label class="form-label small" for="n-@key">Notes</label><input id="n-@key" name="supplement.Notes" value="@s.Notes" class="form-control form-control-sm" maxlength="2000"></div>
    }
</form>
