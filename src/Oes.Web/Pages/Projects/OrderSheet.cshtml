@page "{id:guid}"
@model Oes.Web.Pages.Projects.OrderSheetModel
@using Oes.Domain.Production
@using Oes.Infrastructure.Estimating
@{
    var s = Model.Sheet;
    var d = s.Trade;
    var t = d.Trade;
    var run = s.Takeoff;
    var us = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    string Q(decimal x) => x.ToString("#,0.###", us);
    ViewData["Title"] = $"{d.Project.Number} {d.Type.Name} order sheet";
    if (Model.Print) { Layout = "_PrintLayout"; }
    var hasRules = run.SlotProducts.Count > 0 || run.Lines.Count > 0 || run.Options.Count > 0;
}

@if (Model.Print)
{
    <div class="print-toolbar no-print">
        <a href="/Projects/OrderSheet/@t.Id" class="btn btn-sm btn-outline-light"><i class="bi bi-arrow-left me-1"></i>Back to the order sheet</a>
        <span class="small text-muted">@(t.OrderedAt is null ? "Not ordered yet" : "Ordered " + t.OrderedAt.Value.ToString("MMM d, yyyy"))</span>
        <button type="button" class="btn btn-sm btn-primary" data-print><i class="bi bi-printer me-1"></i>Print / save as PDF</button>
    </div>
    <article class="proposal">
        <header class="proposal-head">
            <div>
                <div class="proposal-company">@Model.Company.Name</div>
                @if (Model.Company.PostalAddress is not null) { <div class="small text-muted pre-wrap">@Model.Company.PostalAddress</div> }
            </div>
            <div class="text-end">
                <div class="proposal-title">Material order</div>
                <div><strong>@d.Project.Number</strong> · @d.Type.Name</div>
                <div class="small text-muted">@DateTime.UtcNow.ToString("MMMM d, yyyy")</div>
            </div>
        </header>
        <section class="proposal-parties">
            <div><div class="label">Supplier</div><div class="fw-semibold">@(t.OrderSupplier ?? "—")</div></div>
            <div><div class="label">Deliver to</div><div>@(d.Property?.SingleLine ?? "—")</div></div>
            <div><div class="label">Job</div><div>@d.Contact.DisplayName</div>@if (t.MaterialDate is { } md) { <div>Needed by @md.ToString("MMM d, yyyy")</div> }</div>
        </section>
        <table class="table table-sm proposal-lines">
            <thead><tr><th style="width:110px">SKU</th><th>Item</th><th class="text-end" style="width:110px">Qty</th><th>Color / notes</th></tr></thead>
            <tbody>
                @foreach (var l in s.Lines)
                {
                    <tr><td>@l.Sku</td><td>@l.Description</td><td class="text-end text-nowrap">@Q(l.Qty) @l.Unit</td><td>@l.Notes</td></tr>
                }
            </tbody>
        </table>
        @if (t.OrderNotes is not null) { <section class="proposal-terms"><h2>Notes</h2><div class="pre-wrap">@t.OrderNotes</div></section> }
        <footer class="proposal-foot">@d.Project.Number · @d.Type.Name · @s.Lines.Count line@(s.Lines.Count == 1 ? "" : "s")</footer>
    </article>
}
else
{
    <div class="page-header">
        <div>
            <h1>Order sheet · @d.Type.Name
                @if (t.OrderedAt is not null) { <span class="badge bg-success-subtle text-success fs-6 align-middle">Ordered</span> }</h1>
            <nav aria-label="breadcrumb"><ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Projects/View/@d.Project.Id">@d.Project.Number @d.Project.Name</a></li>
                <li class="breadcrumb-item"><a href="/Projects/Trade/@t.Id">@d.Type.Name</a></li>
                <li class="breadcrumb-item active">Order sheet</li>
            </ol></nav>
        </div>
        <a class="btn btn-sm btn-outline-secondary" href="/Projects/OrderSheet/@t.Id?print=true"><i class="bi bi-printer me-1"></i>Print for the supplier</a>
    </div>
    <p class="small text-muted">What production buys for this trade. The sold estimate set the price; this sheet can differ.
        Fill it from the takeoff or copy the estimate, then adjust. Refilling replaces only lines that came from that source and haven't been changed.</p>

    <div class="row g-3">
        <div class="col-xl-8">
            <div class="card mb-3">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle">
                        <thead><tr><th>SKU</th><th>Item</th><th class="text-end" style="width:130px">Qty</th><th style="width:220px">Color / notes</th>@if (d.CanEdit) { <th></th> }</tr></thead>
                        <tbody>
                            @if (s.Lines.Count == 0) { <tr><td colspan="5" class="small text-muted">Nothing on the order yet.</td></tr> }
                            @foreach (var l in s.Lines)
                            {
                                var fid = "o-" + l.Id.ToString("N");
                                <tr>
                                    <td class="small"><code>@l.Sku</code></td>
                                    <td>@l.Description <span class="small text-muted">· @(l.Source switch { OrderLineSources.Takeoff => "takeoff", OrderLineSources.Estimate => "estimate", _ => "added" })</span></td>
                                    @if (d.CanEdit)
                                    {
                                        <td><form method="post" asp-page-handler="Update" id="@fid"><input type="hidden" name="lineId" value="@l.Id"></form>
                                            <div class="input-group input-group-sm"><input form="@fid" type="number" step="0.001" min="0" name="qty" value="@l.Qty.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control text-end" aria-label="Quantity"><span class="input-group-text">@l.Unit</span></div></td>
                                        <td><input form="@fid" name="notes" value="@l.Notes" class="form-control form-control-sm" maxlength="300" placeholder="Color, size…" aria-label="Notes"></td>
                                        <td class="text-end text-nowrap">
                                            <button form="@fid" class="btn btn-sm btn-link p-0 me-2" type="submit" title="Save"><i class="bi bi-check-lg"></i></button>
                                            <form method="post" asp-page-handler="Remove" class="d-inline"><input type="hidden" name="lineId" value="@l.Id">
                                                <button class="btn btn-sm btn-link p-0 text-danger" type="submit" title="Remove"><i class="bi bi-trash"></i></button></form>
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="text-end">@Q(l.Qty) @l.Unit</td><td class="small">@l.Notes</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (d.CanEdit)
                {
                    <div class="card-body border-top">
                        <form method="post" asp-page-handler="Add" class="d-flex flex-wrap gap-2 mb-2">
                            <div class="typeahead flex-grow-1" style="min-width:240px" data-typeahead="/api/v1/lookup/products">
                                <input type="hidden" name="productId" data-typeahead-value required>
                                <input class="form-control form-control-sm" autocomplete="off" data-typeahead-input placeholder="Add a product…" aria-label="Product">
                                <div class="typeahead-menu dropdown-menu"></div>
                            </div>
                            <input type="number" step="0.001" min="0" name="qty" class="form-control form-control-sm" style="max-width:100px" placeholder="Qty" required aria-label="Quantity">
                            <input name="notes" class="form-control form-control-sm" style="max-width:180px" maxlength="300" placeholder="Color, size…" aria-label="Notes">
                            <button class="btn btn-sm btn-outline-primary" type="submit">Add</button>
                        </form>
                        <form method="post" asp-page-handler="Add" class="d-flex flex-wrap gap-2">
                            <input name="description" class="form-control form-control-sm flex-grow-1" style="min-width:240px" maxlength="500" placeholder="…or anything else" required aria-label="Description">
                            <input type="number" step="0.001" min="0" name="qty" class="form-control form-control-sm" style="max-width:100px" placeholder="Qty" required aria-label="Quantity">
                            <input name="unit" class="form-control form-control-sm" style="max-width:70px" maxlength="20" placeholder="EA" aria-label="Unit">
                            <button class="btn btn-sm btn-outline-primary" type="submit">Add</button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card mb-3">
                <div class="card-header">Order</div>
                <div class="card-body">
                    @if (t.OrderedAt is { } at)
                    {
                        <div class="text-success mb-2"><i class="bi bi-check-circle me-1"></i>Ordered from <strong>@t.OrderSupplier</strong> on @at.ToString("MMM d, yyyy")@(s.OrderedBy is null ? "" : " by " + s.OrderedBy)</div>
                        @if (t.OrderNotes is not null) { <div class="small pre-wrap mb-2">@t.OrderNotes</div> }
                        @if (d.CanEdit)
                        {
                            <form method="post" asp-page-handler="Ordered"><input type="hidden" name="ordered" value="false">
                                <button class="btn btn-sm btn-outline-secondary" type="submit">Reopen</button></form>
                        }
                    }
                    else if (d.CanEdit)
                    {
                        <form method="post" asp-page-handler="Ordered" class="d-flex flex-column gap-2">
                            <input type="hidden" name="ordered" value="true">
                            <input name="supplier" value="@t.OrderSupplier" class="form-control form-control-sm" maxlength="150" placeholder="Supplier" required aria-label="Supplier">
                            <textarea name="orderNotes" class="form-control form-control-sm" rows="2" maxlength="1000" placeholder="Delivery notes (drop location, contact, PO #)" aria-label="Order notes">@t.OrderNotes</textarea>
                            <button class="btn btn-sm btn-success" type="submit" disabled="@(s.Lines.Count == 0)"><i class="bi bi-truck me-1"></i>Mark as ordered</button>
                        </form>
                    }
                    else { <div class="small text-muted">Not ordered yet.</div> }
                </div>
            </div>

            @if (d.CanEdit && s.EstimateLines > 0)
            {
                <div class="card mb-3">
                    <div class="card-body d-flex align-items-center gap-2">
                        <div class="small flex-grow-1">The sold estimate has @s.EstimateLines material line@(s.EstimateLines == 1 ? "" : "s") for this trade.</div>
                        <form method="post" asp-page-handler="Estimate"><button class="btn btn-sm btn-outline-primary text-nowrap" type="submit">Copy them</button></form>
                    </div>
                </div>
            }

            @if (d.CanEdit && hasRules)
            {
                <div class="card mb-3">
                    <div class="card-header">From the takeoff</div>
                    <div class="card-body">
                        @if (!run.HasMeasurements)
                        {
                            <div class="small text-muted">The property has no @d.Type.Name.ToLowerInvariant() measurements yet.</div>
                        }
                        else
                        {
                            <form method="post">
                                @foreach (var (slot, products) in run.SlotProducts.OrderBy(kv => kv.Key))
                                {
                                    var current = run.Choices.Slots.GetValueOrDefault(slot);
                                    <label class="form-label small mb-1" for="slot-@slot">@TakeoffEngine.Label(slot)</label>
                                    <select id="slot-@slot" name="Choices.Slots[@slot]" class="form-select form-select-sm mb-2">
                                        <option value="">@(products.Count == 0 ? "No products tagged" : "— skip —")</option>
                                        @foreach (var p in products) { <option value="@p.Id" selected="@(current == p.Id)">@p.Name</option> }
                                    </select>
                                }
                                @foreach (var o in run.Options)
                                {
                                    <div class="form-check"><input class="form-check-input" type="checkbox" name="Choices.Options" value="@o.Key" id="opt-@o.Key" checked="@run.Choices.Options.Contains(o.Key)">
                                        <label class="form-check-label small" for="opt-@o.Key">@o.Label</label></div>
                                }
                                @if (Model.Previewed)
                                {
                                    <ul class="list-group list-group-flush small my-2">
                                        @foreach (var l in run.Lines)
                                        {
                                            <li class="list-group-item px-0 d-flex justify-content-between @(l.Problem is null ? "" : "text-muted")">
                                                <span>@(l.Problem is null ? l.Description : l.Rule.Name + " – " + l.Problem)</span><span class="text-nowrap">@Q(l.Qty) @l.Product?.Unit</span></li>
                                        }
                                    </ul>
                                }
                                <div class="d-flex gap-2 mt-2">
                                    <button type="submit" asp-page-handler="Preview" class="btn btn-sm btn-outline-secondary">Preview</button>
                                    <button type="submit" asp-page-handler="Takeoff" class="btn btn-sm btn-primary">Fill the order</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
